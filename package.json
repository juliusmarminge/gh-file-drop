{
  "name": "gh-file-drop",
  "version": "0.1.1",
  "private": true,
  "description": "Upload files to a public URL for sharing in GitHub PRs (Cloudflare Worker + R2)",
  "bin": {
    "ghdrop": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "admin": "node scripts/admin.ts",
    "deploy": "node scripts/admin.ts deploy",
    "keys": "node scripts/admin.ts keys",
    "dev": "alchemy dev --stage local",
    "destroy": "alchemy destroy",
    "cli": "node src/cli.ts",
    "build": "vp pack",
    "build:all": "GHDROP_TARGETS=all vp pack",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@tsdown/exe": "^0.22.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
